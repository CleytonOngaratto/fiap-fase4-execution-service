              }
            ],
            "url": "{{baseUrl}}/execution/v1/work-orders/{{workOrderId}}/repair/start",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Concluir o reparo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.environment.get('attempts') || 0);",
                  "const ready = pm.response.code === 202;",
                  "if (!ready && attempts < 40) {",
                  "  pm.environment.set('attempts', attempts + 1);",
