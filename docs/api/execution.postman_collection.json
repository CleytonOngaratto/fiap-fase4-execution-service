                  "  return;",
                  "}",
                  "pm.environment.unset('attempts');",
                  "pm.test('responde 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/execution/v1/work-orders/{{workOrderId}}/repair/complete",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Falha no diagnóstico",
      "item": [
        {
          "name": "Registrar diagnóstico inviável",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.environment.get('attempts') || 0);",
                  "const ready = pm.response.code === 202;",
                  "if (!ready && attempts < 40) {",
                  "  pm.environment.set('attempts', attempts + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  setTimeout(() => {}, 3000);",
                  "  return;",
                  "}",
                  "pm.environment.unset('attempts');",
                  "pm.test('responde 202', () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/execution/v1/work-orders/{{workOrderId}}/diagnosis/fail",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"sem reparo viável\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Falha no reparo",
      "item": [
        {
          "name": "Registrar falha no reparo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const attempts = Number(pm.environment.get('attempts') || 0);",
                  "const ready = pm.response.code === 202;",
                  "if (!ready && attempts < 40) {",
                  "  pm.environment.set('attempts', attempts + 1);",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "  setTimeout(() => {}, 3000);",
                  "  return;",
                  "}",
                  "pm.environment.unset('attempts');",
                  "pm.test('responde 202', () => pm.response.to.have.status(202));"
                ]
